# 构建产物
android/build-manual/
android/app/build/
android/app/src/main/assets/www/
android/.gradle/
android/local.properties
# 注意：android/debug.keystore 必须入库，不要忽略。
# 它是公开密码（android）的 debug 证书，不是秘密；但签名必须长期稳定，
# 否则每次 CI 全新 checkout 都会生成新密钥，发布出去的 APK 签名各不相同，
# 用户升级时 INSTALL_FAILED_UPDATE_INCOMPATIBLE。

# 运行时状态（都含登录态/访问令牌，绝不能提交）
.ripple-cookie
.ripple-token
# 原子写的临时文件（server.js 写的是 <文件>.tmp-<pid>）：写到一半被杀时会留在这里，
# 内容同样是明文登录态/令牌，别人的 git status 里不该看见它
.ripple-cookie.tmp-*
.ripple-token.tmp-*
.dsh/

# 系统
.DS_Store
Thumbs.db
*.log

# 打包产物（放进 Releases，不进仓库）
dist/releases/
*.apk
*.aab
*.idsig

# 内部文档（代码审查报告等不进公开仓库）
docs/code_review_record/
*代码审查*

# IDE / 编辑器
.idea/
.vscode/
*.iml
*.swp
.cxx/

# 内部产物：审查报告、四份专项明细、用户上传的日志
.review/
docs/user-logs/
docs/代码审查报告.md

# 本地脚本 / 一次性工具
tools/

# AI 协作工具的运行时状态（另一个分支的团队会话、信箱、任务图）
# 不是源码，也不该出现在公开仓库里
.agent-teams/
.workbuddy/

# 注意：docs/screenshots/ 要入库（README 会引用这些图），不要加进忽略列表

# ---------- 桌面端（Tauri）----------
# Rust 构建产物：cargo 会生成几百 MB 的中间文件，绝不能入库
desktop/src-tauri/target/
# 由 desktop/build-frontend.sh 从 app/ 复制 + 注入 bridge.js 生成，
# 是构建产物而不是源码（改前端只改 app/，不要改这里）
desktop/dist/
# Tauri CLI 生成的能力 schema
desktop/src-tauri/gen/

# ---------- Rust 通用 ----------
**/*.rs.bk
Cargo.lock.orig
